{
    "name": "altmenorg/sylius-google-shopping-plugin",
    "type": "sylius-plugin",
    "description": "Sylius 2 plugin: Google Shopping (Merchant Center) product feed written by a console command, one item per variant, shipping costs from the shop's own shipping methods, Google product category on the taxon.",
    "keywords": ["sylius", "sylius-plugin", "google-shopping", "merchant-center", "product-feed", "rss"],
    "license": "MIT",
    "authors": [
        {
            "name": "Altmenorg",
            "homepage": "https://github.com/altmenorg"
        }
    ],
    "require": {
        "php": "^8.2",
        "doctrine/dbal": "^3.8 || ^4.0",
        "doctrine/orm": "^2.18 || ^3.0",
        "sylius/sylius": "^2.0",
        "symfony/console": "^6.4 || ^7.0",
        "symfony/framework-bundle": "^6.4 || ^7.0",
        "symfony/yaml": "^6.4 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Altmenorg\\SyliusGoogleShoppingPlugin\\": "src/",
            "Altmenorg\\SyliusGoogleShoppingPlugin\\Migrations\\": "migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Altmenorg\\SyliusGoogleShoppingPlugin\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false,
            "symfony/flex": false
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1-dev"
        }
    }
}
